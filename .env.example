# Meta / WhatsApp Cloud API
WHATSAPP_GRAPH_API=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_APP_ID=your_app_id
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_REDIRECT_URI=https://your-app.com/oauth-callback
WHATSAPP_ACCESS_TOKEN=  # Optional: System User token (skips OAuth, preferred for server-to-server)
WHATSAPP_TABLE_PREFIX=whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token
WHATSAPP_MEDIA_PATH=uploads/whatsapp  # Storage dir for downloaded inbound media

# Database
DB_DSN=mysql:host=127.0.0.1;dbname=your_db
DB_HOST=127.0.0.1
DB_NAME=your_db
DB_USER=root
DB_PASSWORD=
